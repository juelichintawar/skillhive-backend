<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">



                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Welcome!"
                    android:textColor="#0F172A"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Activity -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNotifications"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_activity_button"
                android:backgroundTint="@null"
                android:elevation="2dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Activity"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>


        <!-- ================= SUBTITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Find skills, offer services and build your campus reputation."
            android:textColor="#64748B"
            android:textSize="14sp" />


        <!-- ================= HERO CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_home_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find the right skill&#10;for your next project"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Connect with talented students around your campus."
                android:textColor="#DCEBFF"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFindServices"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#FFFFFF"
                android:minHeight="0dp"
                android:text="Explore Services  →"
                android:textAllCaps="false"
                android:textColor="#1264E5"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF" />

        </LinearLayout>


        <!-- ================= QUICK ACTIONS ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Quick Actions"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Manage your SkillHive activities"
            android:textColor="#64748B"
            android:textSize="13sp" />


        <!-- ================= OFFER SERVICE ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOfferService"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Offer a Service"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= MY SERVICES ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMyServices"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="My Services"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= RECEIVED ORDERS ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReceivedOrders"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Received Orders"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= MY ORDERS ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMyOrders"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="My Orders"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= WALLET ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWallet"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="My Wallet"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= PROFILE ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="My Profile"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= FAVORITES ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFavorites"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_action"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="My Favorites"
            android:textAllCaps="false"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ================= LOGOUT ================= -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_logout_button"
            android:backgroundTint="@null"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>