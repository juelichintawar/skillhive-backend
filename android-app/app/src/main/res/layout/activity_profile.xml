<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_detail_header"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                android:textColor="#DCEBFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Manage your SkillHive profile"
                android:textColor="#DCEBFF"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================= PROFILE INFORMATION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_detail_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="#0F172A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Keep your profile details up to date."
                android:textColor="#64748B"
                android:textSize="13sp" />


            <!-- ================= PROFILE PHOTO ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_profile_photo"
                    android:clipToOutline="true"
                    android:contentDescription="Profile photo"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Profile Photo"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Add a photo so students can recognize you."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChoosePhoto"
                    android:layout_width="150dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary_button"
                    android:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:text="Choose Photo"
                    android:textAllCaps="false"
                    android:textColor="#1264E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>


            <!-- ================= FULL NAME ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Full Name"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter your full name"
                android:inputType="textPersonName"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />


            <!-- ================= EMAIL ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Email"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_readonly_field"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="Email"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Email cannot be changed here."
                android:textColor="#94A3B8"
                android:textSize="11sp" />


            <!-- ================= PHONE ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Phone"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter your phone number"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />


            <!-- ================= COLLEGE ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="College"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileCollege"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter your college"
                android:inputType="textCapSentences"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />


            <!-- ================= BIO ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Bio"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileBio"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="Tell students about your skills and experience"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="15dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />


            <!-- ================= ROLE ================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Role"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileRole"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_readonly_field"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="Role"
                android:textColor="#64748B"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================= LOADING ================= -->

        <ProgressBar
            android:id="@+id/progressBarProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:visibility="gone" />


        <!-- ================= UPDATE BUTTON ================= -->

        <Button
            android:id="@+id/btnUpdateProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Update Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Your profile helps students know who they are working with."
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>